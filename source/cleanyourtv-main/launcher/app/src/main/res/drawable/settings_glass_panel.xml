<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270"
                android:startColor="#E83B4A60"
                android:centerColor="#D92A3548"
                android:endColor="#E516202F" />
            <stroke android:width="1dp" android:color="#77FFFFFF" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item android:left="2dp" android:top="1dp" android:right="2dp" android:height="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#36FFFFFF" />
            <corners android:radius="2dp" />
        </shape>
    </item>
</layer-list>