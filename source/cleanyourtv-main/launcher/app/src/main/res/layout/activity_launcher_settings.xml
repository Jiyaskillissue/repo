<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/settings_backdrop">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="210dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="@drawable/settings_glass_panel"
            android:elevation="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:text="PREFERENCES"
                android:textColor="#99FFFFFF"
                android:textSize="13sp"
                android:letterSpacing="0.12" />

            <TextView android:id="@+id/navDisplay" style="@style/SettingsRow"
                android:layout_marginBottom="8dp" android:text="Display" />
            <TextView android:id="@+id/navWallpaper" style="@style/SettingsRow"
                android:layout_marginBottom="8dp" android:text="Wallpaper" />
            <TextView android:id="@+id/navMotion" style="@style/SettingsRow"
                android:layout_marginBottom="8dp" android:text="Motion" />
            <TextView android:id="@+id/navSystem" style="@style/SettingsRow"
                android:layout_marginBottom="8dp" android:text="System" />

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:layout_marginTop="20dp" android:layout_marginBottom="16dp"
                android:background="#33FFFFFF" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="14dp"
                android:paddingEnd="12dp"
                android:text="CLEAN YOUR TV"
                android:textColor="#66FFFFFF"
                android:textSize="12sp"
                android:letterSpacing="0.08" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/settingsScroll"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:fillViewport="true"
            android:background="@drawable/settings_glass_panel"
            android:elevation="10dp"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="42dp"
                android:paddingEnd="42dp"
                android:paddingTop="30dp"
                android:paddingBottom="38dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/launcher_settings"
                    android:textColor="#FFFFFFFF"
                    android:textSize="34sp" />

                <TextView
                    android:id="@+id/reorderChoice"
                    style="@style/SettingsRow"
                    android:layout_marginTop="22dp"
                    android:text="@string/reorder"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/displaySection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:paddingBottom="4dp"
                    android:text="DISPLAY &amp; LAYOUT"
                    android:textColor="#B8D9F0"
                    android:textSize="14sp"
                    android:letterSpacing="0.10" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/columns_label"
                    android:textColor="#FFFFFFFF"
                    android:textSize="20sp" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:orientation="horizontal">
                    <TextView android:id="@+id/columns4" style="@style/SettingsColumnChoice" android:text="4" />
                    <TextView android:id="@+id/columns5" style="@style/SettingsColumnChoice" android:text="5" />
                    <TextView android:id="@+id/columns6" style="@style/SettingsColumnChoice" android:text="6" />
                    <TextView android:id="@+id/columns7" style="@style/SettingsColumnChoice" android:text="7" />
                </LinearLayout>

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="18dp" android:text="@string/rows_below_dock_label"
                    android:textColor="#FFFFFFFF" android:textSize="20sp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:orientation="horizontal">
                    <TextView android:id="@+id/rows0" style="@style/SettingsColumnChoice" android:text="0" />
                    <TextView android:id="@+id/rows1" style="@style/SettingsColumnChoice" android:text="1" />
                    <TextView android:id="@+id/rows2" style="@style/SettingsColumnChoice" android:text="2" />
                    <TextView android:id="@+id/rows3" style="@style/SettingsColumnChoice" android:text="3" />
                </LinearLayout>

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="18dp" android:text="@string/dock_opacity_label"
                    android:textColor="#FFFFFFFF" android:textSize="20sp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:orientation="horizontal">
                    <TextView android:id="@+id/dock100" style="@style/SettingsColumnChoice" android:text="100%" />
                    <TextView android:id="@+id/dock70" style="@style/SettingsColumnChoice" android:text="70%" />
                    <TextView android:id="@+id/dock50" style="@style/SettingsColumnChoice" android:text="50%" />
                    <TextView android:id="@+id/dock30" style="@style/SettingsColumnChoice" android:text="30%" />
                </LinearLayout>

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="18dp" android:text="@string/dream_name"
                    android:textColor="#FFFFFFFF" android:textSize="20sp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:orientation="horizontal">
                    <TextView android:id="@+id/clockSystem" style="@style/SettingsColumnChoice" android:text="@string/clock_format_system" />
                    <TextView android:id="@+id/clock12" style="@style/SettingsColumnChoice" android:text="@string/clock_format_12" />
                    <TextView android:id="@+id/clock24" style="@style/SettingsColumnChoice" android:text="@string/clock_format_24" />
                </LinearLayout>

                <TextView
                    android:id="@+id/wallpaperSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp"
                    android:paddingBottom="4dp"
                    android:text="WALLPAPER &amp; SCENES"
                    android:textColor="#B8D9F0"
                    android:textSize="14sp"
                    android:letterSpacing="0.10" />

                <TextView android:id="@+id/wallpaperCuratedChoice" style="@style/SettingsRow"
                    android:layout_marginTop="12dp" android:text="@string/wallpaper_curated" />
                <TextView android:id="@+id/wallpaperImportChoice" style="@style/SettingsRow"
                    android:layout_marginTop="10dp" android:text="@string/wallpaper_import" />
                <TextView android:id="@+id/wallpaperAdjustChoice" style="@style/SettingsRow"
                    android:layout_marginTop="10dp" android:text="@string/wallpaper_adjust" />
                <TextView android:id="@+id/wallpaperChoice" style="@style/SettingsRow"
                    android:layout_marginTop="10dp" />

                <TextView
                    android:id="@+id/motionSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp"
                    android:paddingBottom="4dp"
                    android:text="MOTION &amp; PERFORMANCE"
                    android:textColor="#B8D9F0"
                    android:textSize="14sp"
                    android:letterSpacing="0.10" />

                <TextView android:id="@+id/animationsChoice" style="@style/SettingsRow"
                    android:layout_marginTop="12dp" />
                <TextView android:id="@+id/advancedChoice" style="@style/SettingsRow"
                    android:layout_marginTop="10dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:text="@string/advanced_effects_warning"
                    android:textColor="#FFACB8C1" android:textSize="14sp" />

                <TextView
                    android:id="@+id/systemSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp"
                    android:paddingBottom="4dp"
                    android:text="SYSTEM"
                    android:textColor="#B8D9F0"
                    android:textSize="14sp"
                    android:letterSpacing="0.10" />

                <TextView android:id="@+id/openOnStartChoice" style="@style/SettingsRow"
                    android:layout_marginTop="12dp" android:visibility="gone" />
                <TextView android:id="@+id/followThemeChoice" style="@style/SettingsRow"
                    android:layout_marginTop="10dp" android:text="@string/follow_theme" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="7dp" android:text="@string/follow_theme_hint"
                    android:textColor="#FFACB8C1" android:textSize="14sp" />
                <TextView android:id="@+id/defaultHomeChoice" style="@style/SettingsRow"
                    android:layout_marginTop="20dp" android:text="@string/home_settings" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="7dp" android:text="@string/home_settings_help"
                    android:textColor="#FFACB8C1" android:textSize="14sp" />
                <TextView android:id="@+id/tvSettingsChoice" style="@style/SettingsRow"
                    android:layout_marginTop="18dp" android:text="@string/tv_settings" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>